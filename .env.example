# ===============================================
# KONFIGURASI APLIKASI WEB GARANSI VANCARE ADVAN
# ===============================================

# Port Server Express
PORT=3000
NODE_ENV=development

# -----------------------------------------------
# 1. Supabase Database Configuration
# Dapatkan dari: https://supabase.com -> Project Settings -> API
# -----------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# -----------------------------------------------
# 2. Google Drive API (Penyimpanan Foto/Video Klaim 400GB)
# Masukkan file key Service Account JSON (default: credentials.json)
# dan ID Folder Google Drive / Shared Drive tujuan upload
# -----------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# -----------------------------------------------
# 3. Nodemailer / Gmail SMTP (Notifikasi Otomatis ke Pelanggan)
# Buat "App Password" dari Akun Google Anda:
# Akun Google -> Keamanan -> Verifikasi 2 Langkah -> Sandi Aplikasi (App Passwords)
# -----------------------------------------------
EMAIL_USER=vancare.advan@gmail.com
EMAIL_PASS=your_16_digit_gmail_app_password
EMAIL_FROM_NAME="VANCARE Advan Customer Care"
